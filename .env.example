# Use "demo" to run without IB Gateway, or "ib" for live IB data.
DATA_PROVIDER=demo

# IB Gateway paper defaults to 4002; live defaults to 4001.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=21
IB_BACKFILL_CLIENT_ID=22
IB_TIMEOUT_SECONDS=12

FX_PAIR=USDGBP
BAR_SIZE=1 min
HISTORY_DURATION=1 D
SYNC_INTERVAL_SECONDS=60
SYNC_ON_STARTUP=true
SCHEDULER_ENABLED=true

# Resumable one-minute history CLI. Keep a non-zero request delay with IB.
BACKFILL_START=2017-01-01
BACKFILL_REQUEST_DELAY_SECONDS=10
BACKFILL_MAX_RETRIES=3
BACKFILL_RETRY_DELAY_SECONDS=30

# SQLite is convenient locally. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./fx_tape.db
